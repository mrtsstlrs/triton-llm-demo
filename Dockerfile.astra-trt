# syntax=docker/dockerfile:1.6

FROM nvcr.io/nvidia/tritonserver:24.04-py3 AS triton

FROM registry.astralinux.ru/library/astra/ubi18:1.8.5

ENV DEBIAN_FRONTEND=noninteractive

# Минимальный Astra runtime для Triton + TensorRT backend. Полный DCGM пакет не
# ставим, но libdcgm.so копируем из source image: tritonserver бинарно связан
# с этой библиотекой. Для этого flavor GPU metrics лучше отключать.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libb64-0d \
    libexpat1 \
    libglib2.0-0 \
    libgomp1 \
    libnuma1 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libxml2 \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /models

# TensorRT-only payload: Triton core, tensorrt backend, TensorRT runtime/parser
# libraries и минимальный набор CUDA libraries, которые видны в ldd backend'а.
# Не переносим Python/ONNX/PyTorch/TensorFlow/DALI/OpenVINO/FIL backend'ы.
RUN --mount=from=triton,source=/,target=/triton,ro \
    mkdir -p \
      /opt/tritonserver/backends \
      /usr/local/cuda-12.4/targets/x86_64-linux/lib \
      /usr/lib/x86_64-linux-gnu \
    && cp -a /triton/opt/tritonserver/bin /opt/tritonserver/bin \
    && cp -a /triton/opt/tritonserver/lib /opt/tritonserver/lib \
    && cp -a /triton/opt/tritonserver/caches /opt/tritonserver/caches \
    && cp -a /triton/opt/tritonserver/repoagents /opt/tritonserver/repoagents \
    && cp -a /triton/opt/tritonserver/backends/tensorrt /opt/tritonserver/backends/tensorrt \
    && cp -a \
      /triton/usr/local/cuda-12.4/targets/x86_64-linux/lib/libcublas.so* \
      /triton/usr/local/cuda-12.4/targets/x86_64-linux/lib/libcublasLt.so* \
      /triton/usr/local/cuda-12.4/targets/x86_64-linux/lib/libcudart.so* \
      /triton/usr/local/cuda-12.4/targets/x86_64-linux/lib/libcupti.so* \
      /usr/local/cuda-12.4/targets/x86_64-linux/lib/ \
    && cp -a \
      /triton/usr/lib/x86_64-linux-gnu/libarchive.so.13* \
      /triton/usr/lib/x86_64-linux-gnu/libdcgm.so* \
      /triton/usr/lib/x86_64-linux-gnu/libnvinfer.so* \
      /triton/usr/lib/x86_64-linux-gnu/libnvinfer_plugin.so* \
      /triton/usr/lib/x86_64-linux-gnu/libnvinfer_builder_resource.so* \
      /triton/usr/lib/x86_64-linux-gnu/libnvonnxparser.so* \
      /usr/lib/x86_64-linux-gnu/ \
    && ln -sfn /usr/local/cuda-12.4 /usr/local/cuda \
    && ln -sfn targets/x86_64-linux/lib /usr/local/cuda-12.4/lib64 \
    && rm -rf /opt/tritonserver/third-party-src

ENV PATH="/opt/tritonserver/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/tritonserver/lib:/opt/tritonserver/backends/tensorrt:/usr/local/cuda/lib64:/usr/local/cuda/targets/x86_64-linux/lib:/usr/lib/x86_64-linux-gnu"

EXPOSE 8000 8001 8002

CMD ["tritonserver", "--model-repository=/models", "--allow-gpu-metrics=false"]
